{
  "name": "fin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "data": "node scripts/collect.mjs",
    "backtest": "node scripts/backtest.mjs",
    "deploy": "cf deploy",
    "smoke": "node scripts/smoke.mjs",
    "test:install": "node scripts/check-install.mjs",
    "test:research": "node --test tests/warrants.test.mjs",
    "test:fin": "node scripts/check-fin.mjs",
    "research:collect": "node scripts/research-collect.mjs",
    "research:screen": "node scripts/research-screen.mjs",
    "research:package": "python3 scripts/package-research.py",
    "test:pwa": "node scripts/check-pwa.mjs",
    "research:quotes": "node scripts/research-quotes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@cloudflare/vite-plugin": "latest",
    "@playwright/test": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "cf": "1.0.0-beta.17",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
